/*
 * Example EXTERNAL Nextflow config for running InterProScan 6 on a cluster.
 *
 * This is NOT a GMB config and GMB never reads it. InterProScan 6 is already
 * a Nextflow workflow shipping `slurm`, `singularity` and `apptainer`
 * profiles; this file only supplies the site-specific values those profiles
 * cannot know. GMB's resolver consumes the resulting output files by explicit
 * path and is indifferent to how they were produced.
 *
 * Usage:
 *   nextflow run ebi-pf-team/interproscan6 -r 6.0.1 \
 *       -profile slurm,singularity \
 *       -c docs/interproscan6_cluster.example.config \
 *       --input candidates.faa \
 *       --datadir "$SHARED_INTERPRO_DATA" \
 *       --outdir results --work-dir work
 *
 * EVERY value below marked TBC is a placeholder that must be confirmed
 * against the actual cluster before use -- none of them could be verified
 * from the development laptop. Do not assume Docker is available.
 */

params {
    // TBC: shared, read-only InterPro data directory on the cluster.
    // Must match the --interpro release actually being requested.
    datadir = '/TBC/shared/interproscan6/data'
}

process {
    executor = 'slurm'

    // TBC: real partition/queue name on the target cluster.
    queue = 'TBC-partition'

    // Conservative starting points only -- InterProScan's per-application
    // requirements vary a lot (PANTHER and CATH-FunFam are the heavy ones).
    // TBC: tune against a real run before scaling up.
    cpus = 4
    memory = 16.GB
    time = 4.h

    // Retry once on the transient out-of-memory/timeout exit codes Slurm
    // reports, with more resources on the second attempt.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 1

    withLabel: 'big_mem' {
        // TBC: some member databases need substantially more memory.
        memory = 32.GB
    }
}

executor {
    // TBC: respect the cluster's job submission-rate limits.
    queueSize = 50
    submitRateLimit = '10/1min'
}

singularity {
    enabled = true
    autoMounts = true

    // TBC: writable directory for cached container images. Should be on
    // shared storage so every compute node sees the same image, and should
    // NOT be in $HOME if $HOME has a small quota.
    cacheDir = '/TBC/shared/singularity_cache'

    // TBC: bind mounts required for the data directory and work directory
    // if they are not already visible under autoMounts.
    // runOptions = '--bind /TBC/shared:/TBC/shared'
}

/*
 * If the cluster provides Apptainer rather than Singularity, use
 * `-profile slurm,apptainer` and replace the singularity{} block above with
 * an equivalent apptainer{} block. Both profiles already exist in the
 * workflow; only the block name and cacheDir path change.
 */
