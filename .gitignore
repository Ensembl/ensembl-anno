# Byte-compiled
__pycache__/
*.pyc
# pyenv
.python-version
# environments
.env
env/*
.venv
venv/*
# packaging
build/
*_build*
!**/gene_model_builder.py
eggs/
.eggs*
*.egg-info*
dist/
downloads/
#unit test
.cache
.pytest_cache

# Large data files / symlinks (not tracked in git)
support_scripts/gmb/z_tritici
support_scripts/gmb/c_albicans
support_scripts/gmb/c_auris
support_scripts/gmb/swissprot.dmnd
support_scripts/gmb/uniprot_sprot.fasta
# Any DIAMOND database copied locally for protein validation (e.g. a local
# copy of the cluster's uniprot_euk.fa.dmnd) -- defense in depth, since such
# copies are typically kept outside the repo entirely.
*.dmnd
support_scripts/gmb/*_output*/
support_scripts/gmb/*_comparison*/
support_scripts/gmb/output/
support_scripts/gmb/comparison/

# InterProScan results and Nextflow state. Full InterProScan output runs to
# megabytes per format (the reference 101-protein run produced ~10 MB across
# gff3/json/jsonl/tsv/xml) and the InterPro member-database `data/` directory
# is far larger again -- none of it belongs in Git. Small trimmed parser
# fixtures live in tests/fixtures/interpro/ and ARE tracked deliberately.
.nextflow/
.nextflow.log*
**/interpro_run/
*.faa.jsonl
*.faa.json
*.faa.xml
!support_scripts/gmb/tests/fixtures/interpro/*

.DS_Store
